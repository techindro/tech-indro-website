# Google Gemini AI Key (For AI Shikshak & AI Mentor)
# Get free API key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Hyperswitch (Juspay) Payment Orchestrator Configuration
# If you have an active Hyperswitch account, fill in your credentials below.
# If left as sandbox/test, the server automatically uses local smart-routing sandbox mode.

HYPERSWITCH_API_KEY=snd_test_your_secret_key_here
HYPERSWITCH_PUBLISHABLE_KEY=pk_snd_your_publishable_key_here
HYPERSWITCH_BASE_URL=https://sandbox.hyperswitch.io
HYPERSWITCH_WEBHOOK_SECRET=whsec_sample_secret_key

# Port
PORT=5000
