{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/portfolio",
      "dest": "/portfolio.html"
    },
    {
      "src": "/support",
      "dest": "/support.html"
    },
    {
      "src": "/cyber-playground",
      "dest": "/cyber-playground.html"
    },
    {
      "src": "/tsoc",
      "dest": "/tsoc.html"
    },
    {
      "src": "/quiz",
      "dest": "/quiz.html"
    },
    {
      "src": "/login",
      "dest": "/login.html"
    },
    {
      "src": "/dashboard",
      "dest": "/dashboard.html"
    },
    {
      "src": "/checkout",
      "dest": "/checkout.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
